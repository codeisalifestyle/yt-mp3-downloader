# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored so secrets stay local.

# HTTP / HTTPS proxy URL used by yt-dlp.
# Format:  scheme://[user:pass@]host:port
#
# Note: SOCKS proxies are NOT supported — see README "Notes" for the
# rationale. Use an HTTP CONNECT proxy instead.
#
# Example:
#   YTMP3_PROXY=http://USERNAME:PASSWORD@proxy.example.com:8081
YTMP3_PROXY=

# Default output folder for MP3 files.
# Playlists become a subfolder named after the playlist title.
# Example:
#   YTMP3_OUTPUT=/Volumes/SAMSUNG EVO/Music New
YTMP3_OUTPUT=

# --- Block handling (optional) -------------------------------------------
# When YouTube blocks the proxy IP (403, 429, "sign in to confirm you're
# not a bot", etc.) the downloader can POST your proxy's IP-rotation
# endpoint, optionally poll a status endpoint, and retry the failed item.
# See README "Block handling" for details.

# URL to POST when a block is detected.
# Example:
#   YTMP3_ROTATE_URL=https://relay.example.com/api/proxies/<id>/rotate
YTMP3_ROTATE_URL=

# Authorization header value sent with the rotate (and status) request.
# Example:
#   YTMP3_ROTATE_AUTH=Bearer <relay_api_token>
YTMP3_ROTATE_AUTH=

# Optional GET URL polled until the rotation completes.
# Example:
#   YTMP3_ROTATE_STATUS_URL=https://relay.example.com/api/proxies/<id>/rotation-status
YTMP3_ROTATE_STATUS_URL=
